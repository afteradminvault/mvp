# Supabase project (Database + Auth + Storage). See docs/TECH_STACK.md.
# Safe to expose to the browser: public URL + anon key, protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never prefix with NEXT_PUBLIC_.
# Used only by trusted server-side code (webhooks, background jobs) once those exist.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL, used for auth redirect/callback URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (transactional email). Milestone 0 scaffolds this for one manual
# test send only — no notification templates are wired to it yet (Milestone 1/2).
RESEND_API_KEY=

# OpenAI. Config/env scaffolding only per docs/TECH_STACK.md — not wired to any
# feature at MVP (PRD §3.2: AI assistant is explicitly Phase 2).
OPENAI_API_KEY=

# Stripe: not yet scaffolded. Added at Milestone 4 (billing) per
# docs/DEVELOPMENT_ROADMAP.md — listed here only so its later arrival isn't a surprise.
