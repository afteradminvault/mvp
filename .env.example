# Supabase project (Database + Auth + Storage). See docs/TECH_STACK.md.
# Safe to expose to the browser: public URL + anon key, protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never prefix with NEXT_PUBLIC_.
# Used only by trusted server-side code (webhooks, background jobs) once those exist.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL, used for auth redirect/callback URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (transactional email). Wired to the nomination-invite email
# (Milestone 1 feature 6). Sends are best-effort — a missing key logs a
# warning and skips the send rather than failing the request.
RESEND_API_KEY=

# Optional. Defaults to Resend's shared sandbox sender (onboarding@resend.dev),
# which can only send to the account's own verified address. Set to a
# "Name <email@yourdomain>" once a real sending domain is verified.
RESEND_FROM_EMAIL=

# OpenAI. Config/env scaffolding only per docs/TECH_STACK.md — not wired to any
# feature at MVP (PRD §3.2: AI assistant is explicitly Phase 2).
OPENAI_API_KEY=

# Optional. Set as a Vercel project env var to protect /api/cron/* routes —
# Vercel sends `Authorization: Bearer $CRON_SECRET` on cron invocations
# when this is configured. Unset locally is fine (cron routes just warn).
CRON_SECRET=

# Stripe: not yet scaffolded. Added at Milestone 4 (billing) per
# docs/DEVELOPMENT_ROADMAP.md — listed here only so its later arrival isn't a surprise.
