# Supabase project (Database + Auth + Storage). See docs/TECH_STACK.md.
# Safe to expose to the browser: public URL + anon key, protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never prefix with NEXT_PUBLIC_.
# Used only by trusted server-side code (webhooks, background jobs) once those exist.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL, used for auth redirect/callback URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Not yet wired to any code — added when their respective milestones are built
# (Resend: notification templates, Milestone 1/2; OpenAI: Phase 2 AI assistant;
# Stripe: Milestone 4 billing). Listed here only so future scaffolding isn't a surprise.
